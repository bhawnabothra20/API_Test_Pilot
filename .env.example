# Copy to .env and fill in values. Never commit .env.

# ---- Safety gate (comma-separated). /api-test-pilot refuses any host not listed here.
ALLOWED_HOSTS=petstore.swagger.io,restful-booker.herokuapp.com,jsonplaceholder.typicode.com,reqres.in

# ---- Run tuning (optional)
RESPONSE_TIME_MS=2000
POLITE_DELAY_MS=150
PW_WORKERS=4
PW_RETRIES=1
# CI (--ci): minimum executed coverage in %, below it the run exits with 5
CI_MIN_COVERAGE=80

# ---- Per-API variables: <API_NAME>_<SUFFIX>, API_NAME upper-cased with "-" -> "_"
# Base URL override (otherwise taken from the discovered spec)
# RESTFUL_BOOKER_BASE_URL=
# The ONE identity the agent tests with (admin): username+password (logged in once by global-setup)
# or a ready token / API key. There are no normal-user identities and no OAuth flows: for an
# OAuth2-only API put a ready access token in <API>_ADMIN_TOKEN.
RESTFUL_BOOKER_USERNAME=
RESTFUL_BOOKER_PASSWORD=
# RESTFUL_BOOKER_ADMIN_TOKEN=
# PetStore: any value works as api_key (the docs use "special-key")
# PETSTORE_API_KEY=
# ReqRes: required for /api/logout and for more than 40 requests/day (anonymous limit per IP).
# Free key: sign up at https://app.reqres.in/api-keys. Sent as x-api-key on every ReqRes request.
# REQRES_API_KEY=
# A genuinely expired token (otherwise a synthetic expired JWT is used)
# RESTFUL_BOOKER_EXPIRED_TOKEN=

# ---- MCP server: no token needed. HTTP mode (--http) has no authentication and listens on 127.0.0.1 only.
