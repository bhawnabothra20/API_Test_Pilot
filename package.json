{
  "name": "api-test-pilot",
  "version": "1.0.0",
  "private": true,
  "description": "Autonomous API testing agent: URL -> test design -> qTest Excel -> Playwright+TS tests -> HTML reports",
  "scripts": {
    "api-test": "tsx scripts/api-test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:api": "playwright test",
    "excel": "tsx scripts/build-qtest-excel.ts",
    "report": "tsx scripts/build-summary-report.ts",
    "mcp": "tsx mcp/server.ts",
    "test:unit": "node --import tsx --test --test-reporter=spec \"tests/unit/*.test.ts\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
